RewriteEngine On

# 1. www.naklikay.ru -> naklikay.ru (301)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. /index.html -> / (301). Убирает дубли страниц.
# Условие смотрит на исходную строку запроса, поэтому
# внутренняя подстановка DirectoryIndex не даёт зацикливания.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
