RewriteEngine On

# 1. Точные канонические URL. Выполняются до DirectorySlash, чтобы прокси не
#    возвращал HTTP-адрес после принудительного перехода на HTTPS.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://naklikay.ru/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog[\s?] [NC]
RewriteRule ^blog$ https://naklikay.ru/blog/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog/reklama-internet-magazina-v-yandekse[\s?] [NC]
RewriteRule ^blog/reklama-internet-magazina-v-yandekse$ https://naklikay.ru/blog/reklama-internet-magazina-v-yandekse/ [R=301,L]

# 1. www.naklikay.ru -> naklikay.ru (301)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. /index.html -> / (301). Убирает дубли страниц.
# Условие смотрит на исходную строку запроса, поэтому
# внутренняя подстановка DirectoryIndex не даёт зацикливания.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; frame-src https://mc.yandex.ru; form-action 'self'; upgrade-insecure-requests"
</IfModule>
